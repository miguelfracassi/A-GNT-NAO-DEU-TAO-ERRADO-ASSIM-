{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/((?!join|api/|assets/|administracao|niverdamel|site\\.css|site\\.js|favicon\\.svg).*)",
      "destination": "/join",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/administracao/ticord/inscrições-join", "destination": "/administracao/ticord/inscricoes-join" },
    { "source": "/administracao/ticord/inscrições-join.html", "destination": "/administracao/ticord/inscricoes-join" },
    { "source": "/administracao/ticord/inscri%C3%A7%C3%B5es-join", "destination": "/administracao/ticord/inscricoes-join" },
    { "source": "/administracao/ticord/inscri%C3%A7%C3%B5es-join.html", "destination": "/administracao/ticord/inscricoes-join" }
  ],
  "headers": [
    { "source": "/administracao/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
